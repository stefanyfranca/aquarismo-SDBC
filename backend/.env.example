# Aplicação
PORT=3000

# Credenciais do banco PostgreSQL — preencha seus valores apenas em .env (nunca commitar)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquarismo_sdbc
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Alternativa opcional à conexão acima (se definida, sobrescreve os campos individuais)
# DATABASE_URL=postgres://usuario:senha@localhost:5432/seu_banco

# Pool de conexões
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000

# Use true se o servidor for remoto e exigir SSL
DB_SSL=false

# Backup: use somente diretórios dedicados e absolutos. Separe múltiplas raízes por ; no Windows ou : no Linux.
BACKUP_ALLOWED_ROOTS=C:\\backups
BACKUP_DEFAULT_DESTINATION=C:\\backups
PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe
PG_RESTORE_PATH=C:\\Program Files\\PostgreSQL\\18\\bin\\pg_restore.exe
SEVEN_ZIP_PATH=7z

# Obrigatórias somente quando as respectivas opções forem habilitadas.
# Chave AES-256 codificada em base64 (32 bytes antes da codificação).
BACKUP_ENCRYPTION_KEY=
ZIP_PASSWORD=
